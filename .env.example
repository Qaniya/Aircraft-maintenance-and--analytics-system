# =============================================================================
# Environment Variables for Aircraft Maintenance Analytics System
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =============================================================================

# Flask
FLASK_ENV=production
SECRET_KEY=<generate-a-64-char-random-string>
JWT_SECRET_KEY=<generate-a-64-char-random-string>

# Database (Azure Database for PostgreSQL)
DATABASE_URL=postgresql://psqladmin:<password>@<server>.postgres.database.azure.com:5432/aircraft_maintenance?sslmode=require

# Azure App Service
WEBSITES_PORT=5000

# Azure Key Vault (optional - enable for production)
# AZURE_KEY_VAULT_URL=https://kv-aircraft-maintenance-prod.vault.azure.net/

# Logging
LOG_LEVEL=info

# Application Insights (auto-configured by Azure)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
